# Local example values only. No real secrets. Compose already has these
# defaults; copy to .env only to override.

INSTANCE_ID=wallet-local
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=20s

DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet?sslmode=disable
DB_MAX_CONNS=20

OIDC_ISSUER_URL=http://localhost:8180/realms/wager
OIDC_JWKS_URL=http://localhost:8180/realms/wager/protocol/openid-connect/certs
OIDC_AUDIENCE=wager-wallet-api

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_INPUT_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wallet-events.fifo

# Pending references: backoff 1s, 2s, 4s ... up to 30s, give up after 5 minutes.
REFERENCE_RETRY_BASE=1s
REFERENCE_RETRY_MAX=30s
REFERENCE_TTL=5m

OUTBOX_LEASE=30s
OUTBOX_BATCH=50
WORKER_INTERVAL=500ms

POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
POSTGRES_DB=wallet
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
